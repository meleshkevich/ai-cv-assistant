{
  "manifest_version": 3,
  "name": "AI Job Assistant",
  "version": "0.1.0",
  "description": "Analyze job descriptions and generate tailored application documents.",
  "minimum_chrome_version": "116",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],

  "host_permissions": ["https://api.openai.com/*"],

  "optional_host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "action": {
    "default_title": "AI Job Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
