{
  "name": "ai-job-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "prebuild": "node scripts/create-icons.mjs",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
